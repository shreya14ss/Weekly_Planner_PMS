    "@angular/compiler-cli": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@types/pouchdb": "^6.4.2",
    "angular-eslint": "22.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.0.8"
  }
